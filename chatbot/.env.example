# ---- LLM provider ----
# "groq"      -> free for development (no credit card; key from console.groq.com)
# "anthropic" -> Claude (production target; paid)
LLM_PROVIDER=groq
MAX_TOKENS=1024

# ---- Groq (free dev option) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# A strong, free, fast model. Alternatives: llama-3.1-8b-instant (faster),
# openai/gpt-oss-20b, etc. See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Anthropic (production) ----
# Get a key at https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Haiku 4.5 is fast + cheap and ideal for a doc-grounded support bot. Swap to
# claude-sonnet-4-6 or claude-opus-4-8 for higher quality at higher cost.
CHATBOT_MODEL=claude-haiku-4-5

# ---- Embeddings (local, free) ----
# Any model supported by fastembed. bge-small is 384-dim, fast, good quality.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Documents / index ----
DOCS_DIR=data/docs
INDEX_DIR=data/index

# Retrieval tuning
TOP_K=4
# Drop retrieved chunks below this cosine similarity (0-1). Raise to be stricter
# about staying grounded; lower if the bot says "I don't know" too often.
MIN_SCORE=0.3

# Chunking (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---- Server ----
# Comma-separated list of allowed origins for CORS, or * for any.
# In production set this to your portfolio's origin, e.g. https://your-site.com
ALLOWED_ORIGINS=*
RATE_LIMIT=20/minute
